{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:import/recommended"],
  "globals": {
    "SugarCube": "readonly",
    "mycode": "writable",
    "firstload": "readonly",
    "alt_fetch": "readonly",
    "testedOn": "readonly",
    "cheatVer": "readonly",
    "isServer": "readonly",
    "buttonActions": "readonly",
    "reactivateToggles": "readonly",
    "initStorage": "readonly",
    "initListeners": "readonly",
    "loadall": "readonly",
    "init_interface": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "settings": {
    "import/resolver": {
      "node": {
        "paths": ["src"]
      }
    }
  },
  "rules": {
    "no-console": "off",
    "import/no-relative-parent-imports": "off"
  }
}
