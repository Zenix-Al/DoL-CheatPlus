{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:import/recommended"],
  "globals": {
    "__DOL_CHEAT_VERSION__": "readonly",
    "__DOL_DEBUG__": "readonly",
    "SugarCube": "readonly",
    "mycode": "writable",
    "firstload": "readonly",
    "alt_fetch": "readonly",
    "testedOn": "readonly",
    "cheatVer": "readonly",
    "isServer": "readonly",
    "buttonActions": "readonly",
    "reactivateToggles": "readonly",
    "initStorage": "readonly",
    "initListeners": "readonly",
    "loadall": "readonly",
    "init_interface": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "settings": {
    "import/resolver": {
      "node": {
        "paths": ["src"]
      }
    }
  },
  "rules": {
    "no-console": "off",
    "max-depth": ["warn", 4],
    "import/no-relative-parent-imports": "off",
    "import/order": [
      "error",
      {
        "groups": ["builtin", "external", "internal", "parent", "sibling", "index"],
        "newlines-between": "always"
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "ImportExpression",
        "message": "Use top-level imports where possible; dynamic import() should be explicitly documented with /* allow-dynamic-import */ when intentional."
      },
      {
        "selector": "MemberExpression[object.name='window']",
        "message": "Avoid direct window.* usage. Use module imports/accessors, or annotate explicit bridge registration lines only."
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "unsafeWindow",
        "message": "Use getRuntimeWindow() from core/global-bridge.js; direct unsafeWindow usage is restricted."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/ui/**/*.js"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "../features/*",
              "../../features/*",
              "../../../features/*",
              "src/features/*"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**/*.js"],
      "rules": {
        "no-restricted-globals": [
          "warn",
          {
            "name": "SugarCube",
            "message": "Use core/sugarcube adapters (adapter.js, state.js, cheat-config.js) instead of direct SugarCube globals."
          }
        ]
      }
    }
  ]
}
