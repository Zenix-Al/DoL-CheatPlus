{
  "name": "DoL-CheatPlus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build/build.cjs",
    "lint:actions": "node build/validate-action-ids.cjs",
    "lint:actions:strict": "node build/validate-action-ids.cjs --strict-parity --strict-metadata-unique",
    "test": "node --test test/unit test/integration test/regression",
    "lint": "eslint --ignore-path .gitignore .",
    "lint:fix": "eslint --fix --ignore-path .gitignore .",
    "format": "prettier --write .",
    "publish": "cmd /c \"cd _compiled && publish.bat\""
  },
  "dependencies": {
    "clean-css-cli": "^5.6.3",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "eslint": "^8.50.0",
    "eslint-plugin-import": "^2.30.0",
    "jsdom": "^22.1.0",
    "prettier": "^2.8.8"
  }
}
